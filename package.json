{
  "name": "Macroni",
  "version": "1.0.0",
  "description": "Minimal macOS GUI for managing cron jobs, powered by Electrobun",
  "scripts": {
    "css": "bunx @tailwindcss/cli -i src/mainview/styles.css -o src/mainview/index.css",
    "dev": "bun run css && electrobun dev",
    "build": "bun run css && electrobun build",
    "start": "bun run build && bun run dev",
    "install:app": "cp -rv ./build/stable-macos-arm64/Macroni.app /Applications/"
  },
  "dependencies": {
    "crontab": "^1.3.0",
    "electrobun": "latest",
    "lucide-react": "^1.16.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.0.0",
    "@types/bun": "latest",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
